// Orientation of a object
interface IOrientator extends IVector2 {
    var rotation: IVector2;
}

// Constructor for orientator
classfunc Orientator(_pos, _lookat) extends IOrientator {
    var _tmp = Object();

    // Check and fix pos
    if (instanceof(_pos, IVector2)) {
        _tmp.set("pos", _pos);
    } else {
        _tmp.set("pos", WorldMath.zero());
    }

    // Check and fix rotation
    if (instanceof(_lookat, IVector2)) {
        _tmp.set("lookat", _lookat);
    } else {
        _tmp.set("lookat", WorldMath.zero());
    }

    // instance
    var pos = _tmp.pos;
    pos.set("rotation", _tmp.lookat);
    
    return pos;
}

// A thing in the world 2d space
interface SpacedThing {
    var origin: IOrientator;
}

// A Base Of Body
interface BaseBody extends SpacedThing {
    var nofall: boolean;
    var linearVelocity: IVector2;
    var color: IColor;
    var orientator: IOrientator;
    var mass: number;
    var size: IVector2;
}