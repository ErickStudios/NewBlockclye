
// Interface for Position In The Space
interface IVector3 {
    var x: number;
    var y: number;
    var z: number;
}

// A Position In The Space
classfunc Vector3(x, y, z) extends IVector3 {
    var cls = Object();
    cls.set("x", x);
    cls.set("y", y);
    cls.set("z", z);
    return cls;
}

// Class Functor For World Functions
var WorldMath = Object();

// Vectors For Operations
WorldMath.set("zero3", func() { return Vector3(0,0,0); });
WorldMath.set("one3", func() { return Vector3(1,1,1); });

// Vector3 + Vector3
WorldMath.set("add3", func(a, b) {
    if (instanceof(a, IVector3)) {
        if (instanceof(b, IVector3)) {
            return Vector3(Math.add(a.x, b.x),Math.add(a.y, b.y),Math.add(a.z, b.z));
        }
    }

    return Vector3();
});

// Vector3 - Vector3
WorldMath.set("sub3", func(a, b) {
    if (instanceof(a, IVector3)) {
        if (instanceof(b, IVector3)) {
            return Vector3(Math.sub(a.x, b.x),Math.sub(a.y, b.y),Math.sub(a.z, b.z));
        }
    }

    return Vector3();
});

// Vector3 * Vector3
WorldMath.set("mul3", func(a, b) {
    if (instanceof(a, IVector3)) {
        if (instanceof(b, IVector3)) {
            return Vector3(Math.mul(a.x, b.x),Math.mul(a.y, b.y),Math.mul(a.z, b.z));
        }
    }

    return Vector3();
});

// Vector3 / Vector3
WorldMath.set("div3", func(a, b) {
    if (instanceof(a, IVector3)) {
        if (instanceof(b, IVector3)) {
            return Vector3(Math.div(a.x, b.x),Math.div(a.y, b.y),Math.div(a.z, b.z));
        }
    }

    return Vector3();
});

// Vector3 * number
WorldMath.set("muln3", func(a, n) {
    return WorldMath.mul3(a, Vector3(n, n, n));
});

// Vector3 / number
WorldMath.set("divn3", func(a, n) {
    return WorldMath.div3(a, Vector3(n, n, n));
});

exportToGlobal("WorldMath", WorldMath);
exportToGlobal("IVector3", IVector3);